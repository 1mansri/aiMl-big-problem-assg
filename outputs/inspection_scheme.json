 "inspection_types": [
  {
   "type": "superficial (patrol)",
   "interval": "monthly",
   "by": "maintenance staff",
   "scope": "drive-over and walk-along: joints, drains, barriers, wearing coat, visible damage"
  },
  {
   "type": "routine",
   "interval": "twice a year (pre- and post-monsoon)",
   "by": "bridge engineer",
   "scope": "all components from deck and ground with binoculars; bearings and joints close up; app records"
  },
  {
   "type": "principal (detailed)",
   "interval": "every 3 years and at handing over",
   "by": "experienced bridge engineer",
   "scope": "hands-on, under-bridge unit; every location of the hierarchy; crack mapping; baseline NDT grid"
  },
  {
   "type": "special",
   "interval": "after flood, earthquake, vehicle impact, fire, overload, or a monitoring alarm",
   "by": "specialist",
   "scope": "targeted: NDT, load test, structural assessment"
  }
 ],
 "ndt_programme": [
  {
   "defect": "longitudinal crack / rust staining along a duct line (girder bottom flange)",
   "question": "Are the prestressing strands corroding? Is the duct fully grouted?",
   "tests": [
    "half-cell potential grid over the duct line",
    "concrete resistivity (Wenner)",
    "cover meter",
    "GPR / ultrasonic tomography over the duct",
    "chloride profile from drilled dust",
    "if indicated: endoscope through a drilled hole into the duct"
   ],
   "interpretation": "potential < -350 mV CSE with resistivity < 10 kOhm cm: active corrosion likely; chloride at duct depth > 0.2 % of cement: depassivation of strand likely; tomography anomaly: grout void -> re-grouting (vacuum injection)",
   "locations": "along each cracked duct line, 0.25 m grid, +-1 m beyond the visible crack"
  },
  {
   "defect": "transverse flexural cracks at the soffit near mid-span",
   "question": "Has the girder lost prestress (designed uncracked)?",
   "tests": [
    "crack width / length mapping and tell-tales or crack gauges",
    "UPV across the crack (crack depth)",
    "VW strain and levelling trend vs. reference curve",
    "load test (deflection, strain, crack opening)"
   ],
   "interpretation": "cracks opening under traffic and a strain / camber trend away from the reference curve indicate prestress loss; compare decompression load in the load test with design",
   "locations": "L/4 .. 3L/4 of the affected girder, all faces of the bottom flange"
  },
  {
   "defect": "diagonal web cracks near the supports",
   "question": "Is the shear capacity or the end-block reinforcement adequate?",
   "tests": [
    "crack mapping, width monitoring",
    "UPV (direct, through the web)",
    "cover meter for link spacing",
    "load test with trucks near the support"
   ],
   "interpretation": "cracks > 0.2 mm or growing: detailed shear assessment with as-built links",
   "locations": "from the bearing to 1.5 d, both faces of the web"
  },
  {
   "defect": "honeycombing / surface deterioration / doubtful concrete",
   "question": "Is the in-situ concrete quality and strength adequate?",
   "tests": [
    "rebound hammer (IS 516 Part 5/Sec 4)",
    "UPV (IS 516 Part 5/Sec 1)",
    "combined rebound + UPV (SonReb) calibrated on cores (IS 516 Part 4)"
   ],
   "interpretation": "UPV well below the healthy reference (e.g. < 3.75 km/s, 'doubtful' in IS 516-5-1) or rebound below reference - 2 sd: take cores; estimate strength from the calibrated curve",
   "locations": "grid of test areas around the defect plus reference areas on sound concrete of the same element"
  },
  {
   "defect": "spalling / delamination / exposed rebar on the deck soffit or cross girders",
   "question": "How far does corrosion-induced delamination extend? What is causing it?",
   "tests": [
    "hammer sounding",
    "half-cell potential",
    "cover meter",
    "carbonation depth (phenolphthalein)",
    "chloride profile"
   ],
   "interpretation": "carbonation depth >= cover or chloride > 0.4 % of cement at rebar: corrosion initiated; repair extent = hollow-sounding area + 0.3 m",
   "locations": "the bay concerned on a 0.5 m grid, plus one sound bay as reference"
  },
  {
   "defect": "leakage / efflorescence at girder ends below an expansion joint",
   "question": "Is chloride-laden water reaching the end blocks, anchorages and bearings?",
   "tests": [
    "chloride profile at anchorage zones",
    "half-cell potential on end blocks",
    "resistivity",
    "visual check of anchorage protection (open the pocket if necessary)"
   ],
   "interpretation": "chloride rising with depth and potentials more negative than -350 mV: anchorage at risk; replace the joint seal first, then repair",
   "locations": "end blocks of all girders under the leaking joint (0.25 m grid over 1.5 m)"
  },
  {
   "defect": "bursting / splitting cracks in the anchorage zone",
   "question": "Is the anchorage-zone reinforcement working? Is the anchorage itself sound?",
   "tests": [
    "crack mapping",
    "UPV",
    "GPR for bursting steel",
    "impact-echo on the anchorage pocket"
   ],
   "interpretation": "cracks > 0.2 mm or voids behind the plate: specialist assessment of the anchorage",
   "locations": "end face and 1 m of the end block"
  },
  {
   "defect": "bearing shear deformation, bulging, splitting, walking or seizure",
   "question": "Is the bearing accommodating movement and rotation as designed?",
   "tests": [
    "measure shear deformation and bulging with a gauge",
    "bearing-displacement transducer: movement vs. temperature",
    "Shore A hardness of the elastomer",
